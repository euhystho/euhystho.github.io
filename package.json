{
  "name": "eugene-personal-website",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && tsc -b && astro build",
    "preview": "astro check && astro build && astro preview",
    "astro": "astro",
    "format": "prettier . --write",
    "test:visual": "playwright test --project=chromium",
    "test:mobile": "playwright test --project=mobile-chrome --project=mobile-webkit",
    "test:accessibility": "playwright test --project=chromium --grep \"axe audit\"",
    "lighthouse": "bunx lighthouse http://localhost:4321 --config-path=config/lighthouse.config.js --view",
    "test:performance": "concurrently -k --success first \"bun run build && bunx astro preview --host 127.0.0.1 --port 4321\" \"wait-on http://127.0.0.1:4321 && bunx lighthouse http://127.0.0.1:4321 --config-path=config/lighthouse.config.js\""
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/mdx": "7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.6",
    "@astrojs/svelte": "9.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "astro-icon": "^1.2.0",
    "astro-pagefind": "^1.8.6",
    "concurrently": "^9.2.5",
    "embla-carousel-autoplay": "^8.6.0",
    "lighthouse": "^13.6.0",
    "svelte": "^5.59.1",
    "svelte-radix": "^3.0.2",
    "svelte-toolbelt": "^0.10.7",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "wait-on": "^9.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.4",
    "@lucide/svelte": "^0.577.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^25.9.10",
    "autoprefixer": "^10.7.0",
    "axe-core": "^4.14.1",
    "clsx": "^2.1.1",
    "pagefind": "^1.6.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "tailwind-merge": "^3.7.1",
    "tailwind-variants": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod-to-ts": "^2.1.0"
  }
}
