---
interface Props {
  title: string;
  items: string[];
  color?: "teal" | "blue" | "gray";
  size?: "small";
}

const { title, items, color = "gray", size } = Astro.props;

const colorClasses = {
  teal: "border-teal-300 bg-teal-50 text-teal-700 dark:border-teal-600 dark:bg-teal-900/20 dark:text-teal-300",
  blue: "border-blue-300 bg-blue-50 text-blue-700 dark:border-blue-600 dark:bg-blue-900/20 dark:text-blue-300",
  gray: "border-gray-300 bg-gray-50 text-gray-700 dark:border-gray-600 dark:bg-gray-900/20 dark:text-gray-300",
};

const pillClass = `inline-block rounded-full border ${size === "small" ? "text-xs px-3 py-1" : "text-sm px-4 py-1.5"} ${colorClasses[color]}`;
---

<div>
  <div
    class=`text-text/70 ${size === "small" ? " mb-2 text-xs" : "mb-3 text-sm tracking-wide uppercase"} font-semibold `
  >
    {title}
  </div>
  <div class=`flex flex-wrap ${size === "small" ? "gap-2" : "gap-2.5"}`>
    {items.map((item) => <span class={pillClass}>{item}</span>)}
  </div>
</div>
