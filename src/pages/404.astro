---
import { Font } from "astro:assets";
import BaseHead from "../components/layouts/BaseHead.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Oops, Page Was Not Found!"
      description="Error 404: Your page was not found, enjoy Mayhem the Bunny!"
    />
    <Font cssVariable="--font-gothic" />
    <style>
      .bunny-curtain {
        position: relative;
        overflow: hidden;
      }

      .curtain-overlay {
        position: fixed;
        z-index: 100;
        inset: 0;
        width: 100vw;
        height: 100dvh;
        pointer-events: none;
      }

      .static-bunny {
        display: none;
        font-size: 14rem;
        line-height: 1;
      }

      .pet-button.petted {
        animation: pet-bunny 450ms ease-in-out ;
      }

      @keyframes pet-bunny {
        35% {
          transform: translateY(-0.75rem) rotate(-4deg) scale(1.04);
        }
        70% {
          transform: translateY(0.1rem) rotate(3deg) scale(0.98);
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .curtain-overlay,
        .pet-bunny {
          display: none;
        }

        .pet-button.petted {
          animation: none;
        }

        .static-bunny {
          display: block;
        }
      }
    </style>
  </head>
  <body
    class="bg-card overflow-x-hidden"
    style="cursor:url('/svg/carrot-pointer.svg') 12 8, auto;"
  >
    <div class="site">
      <header class="bg-primary pr-4 pb-4 pl-4 shadow-lg backdrop-blur-md">
        <h1 class="p-3 text-center text-5xl text-white md:text-6xl">
          🎩 Ta-da!
          <br />
          Wait, that's not right...
        </h1>
        <h2 class="p-4 text-center font-sans text-2xl text-white md:text-3xl">
          Our magician was supposed to pull up your page, but it looks like
          <button
            type="button"
            id="open-music-choices"
            aria-haspopup="dialog"
            aria-controls="music-choices"
            class="mr-2 ml-2 underline decoration-dotted underline-offset-4 hover:text-[#FF5D36] focus-visible:outline-2 focus-visible:outline-offset-4"
            style="cursor:url('/svg/music.svg') 24 24, pointer;"
          >
            Mayhem
          </button>
          the Bunny got out instead!
        </h2>
      </header>
      <main>
        <div class="bunny-curtain rounded-xs">
          <div
            class="mx-auto flex w-full max-w-xs flex-col items-center justify-center sm:max-w-sm md:max-w-md lg:min-h-[50vh] sm:md:lg:w-[60vw]"
          >
            <button
              type="button"
              class="pet-button focus-visible:outline-primary rounded-xl focus-visible:outline-2 focus-visible:outline-offset-4"
              aria-label="Pet Mayhem the Bunny"
              aria-describedby="pet-status"
            >
              <img
                src="/svg/mayhem_the_bunny.svg"
                alt=""
                aria-hidden="true"
                class="pet-bunny block h-auto w-full max-w-112.5"
              />
              <span class="static-bunny" aria-hidden="true">🐰</span>
            </button>
            <p id="pet-status" role="status" aria-live="polite" class="sr-only">
              Pet Mayhem for a reaction.
            </p>
          </div>
        </div>
      </main>
      <footer class="bg-primary overflow-hidden bg-cover backdrop-blur-md">
        <h3 class="m-8 pt-4 text-center text-3xl text-white">
          Don't worry! You got some options:
        </h3>
        <ul
          class="relative m-8 flex flex-col items-center justify-center gap-5 rounded-2xl transition-all duration-100 md:flex-row md:gap-10"
        >
          <li>
            <a
              href="/"
              class="mb-4 flex items-center justify-center rounded-2xl border-2 border-transparent bg-[#0b433b] p-4 text-center text-white shadow-sm backdrop-blur-md transition-colors duration-350 hover:bg-[#082e29] hover:inset-shadow-sm"
              style="cursor:url('/svg/key.svg') 12 12, pointer;"
            >
              <span class="text-2xl text-white">
                🏠 Guess, I'll go back home then...
              </span>
            </a>
          </li>
          <li>
            <a
              href="mailto:hello@eugenehysthompson.com"
              class="mb-4 flex items-center justify-center rounded-2xl border-2 border-transparent bg-[#0b433b] p-2 pt-4 pb-4 text-center text-white shadow-sm backdrop-blur-md transition-colors duration-350 hover:bg-[#082e29] hover:inset-shadow-sm"
              style="cursor: url('/svg/megaphone.svg') 24 24, pointer;"
            >
              <span class="text-2xl text-white">
                😠 I want to complain to management!!!
              </span>
            </a>
          </li>
        </ul>
      </footer>
      <dialog
        id="music-choices"
        aria-labelledby="music-choices-title"
        class="bg-background text-text m-auto w-[min(90vw,32rem)] rounded-2xl p-6 shadow-2xl backdrop:bg-black/60"
      >
        <h2 id="music-choices-title" class="font-gothic text-[#603454] dark:text-[#FF5D36] text-center text-2xl font-semibold">
          Listen to MAYHEM the Bunny's favorite album!
        </h2>
        <p class="font-serif mt-2 text-center text-base">
          Select your preferred music service for some hoppin tunes!
        </p>
        <ul class="mt-5 flex flex-row items-center justify-center gap-3">
          <li>
            <a
              href="https://music.apple.com/us/album/apple-music-live-mayhem-requiem/6768201775"
              target="_blank"
              rel="noopener noreferrer"
              class="font-gothic inline-flex rounded-lg bg-black px-4 py-2 font-semibold text-white italic underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2"
            >
              Apple Music Requiem
            </a>
          </li>
          <li>
            <a
              href="https://open.spotify.com/album/3ARwSvDQv2OHYnLeDC3Lxi"
              target="_blank"
              rel="noopener noreferrer"
              class="font-gothic inline-flex rounded-lg bg-[#1ED760] px-4 py-2 font-semibold text-white underline-offset-4 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2"
            >
              Spotify Mayhem
            </a>
          </li>
        </ul>
        <form method="dialog" class="mt-6 text-right">
          <button
            class="font-gothic bg-[#FF5D36] dark:bg-accent dark:text-[#FF5D36] rounded-lg px-4 py-2 font-semibold focus-visible:outline-2 focus-visible:outline-offset-2"
          >
            Close
          </button>
        </form>
      </dialog>
    </div>
    <object
      id="curtain-overlay"
      data="/svg/error_curtains.svg"
      type="image/svg+xml"
      aria-hidden="true"
      tabindex="-1"
      class="curtain-overlay"></object>
    <script>
      const curtainObject =
        document.querySelector<HTMLObjectElement>("#curtain-overlay");
      let curtainAnimationStarted = false;

      function startCurtainReveal() {
        if (curtainAnimationStarted) return;
        const curtainSvg = curtainObject?.contentDocument?.querySelector("svg");
        if (!curtainSvg) return;

        curtainAnimationStarted = true;
        curtainSvg.setAttribute("preserveAspectRatio", "xMidYMid slice");
        curtainSvg.pauseAnimations();
        curtainSvg.setCurrentTime(0);

        if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
          curtainSvg.unpauseAnimations();
          window.setTimeout(() => {
            curtainObject?.remove();
          }, 655);
        }
      }

      curtainObject?.addEventListener("load", startCurtainReveal, {
        once: true,
      });
      if (curtainObject?.contentDocument?.readyState === "complete") {
        startCurtainReveal();
      }

      const musicButton = document.querySelector<HTMLButtonElement>(
        "#open-music-choices",
      );
      const musicDialog =
        document.querySelector<HTMLDialogElement>("#music-choices");
      musicButton?.addEventListener("click", () => musicDialog?.showModal());

      const petButton =
        document.querySelector<HTMLButtonElement>(".pet-button");
      const petStatus = document.querySelector<HTMLElement>("#pet-status");
      let petCount = 0;

      petButton?.addEventListener("click", () => {
        petCount += 1;
        petButton.classList.remove("petted");
        requestAnimationFrame(() => petButton.classList.add("petted"));
        if (petStatus) {
          petStatus.textContent =
            petCount === 1
              ? "Mayhem enjoyed that!"
              : `Mayhem enjoyed that! ${petCount} pets so far.`;
        }
      });
    </script>
  </body>
</html>
