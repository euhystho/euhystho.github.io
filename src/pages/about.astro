---
import MainLayout from "../components/layouts/MainLayout.astro";
import Image from "astro/components/Image.astro";
import bgImage from "public/images/about.jpeg";
import Skills from "src/components/ui/skills.astro";
---

<MainLayout title="About Eugene">
  <main class="mx-auto w-full max-w-6xl px-4">
    <!-- Hero Section -->
    <section class="mt-0.75">
      <Image
        src={bgImage}
        alt="Picture of Eugene"
        class="w-full rounded-tl-md rounded-tr-md"
      />
      <div
        class="bg-card/50 grid grid-cols-1 items-start gap-6 rounded-br-md rounded-bl-md pt-8 pr-8 pb-4 pl-8 md:gap-8"
      >
        <div>
          <h1 class="text-heading mb-6 text-2xl font-bold md:text-3xl">
            Eugene Thompson
          </h1>

          <p class="text-text/80 mb-4 text-base leading-relaxed">
            I'm an Applied Mathematics graduate from Ursinus College, where I
            spent a lot of time figuring out how my childhood fascination with
            Excel spreadsheets and data visualization could actually be a
            career. My vested interest in personal finance got me involved with
            Ursinus' Financial Services Office, where I helped build interactive
            financial calculators that are distinctly Gen Z, not your typical
            old-fashioned beige finance tool. Through suggestions from my
            professor during the project, I added Monte Carlo simulations to
            make the calculator more realistic, albeit a lot harder to build
            than a typical financial calculator. I also mapped
            out commercial real estate trends at DataFest Philly 2025, a project
            inspired by my mom's industry, and built economic R Shiny dashboards
            that got me genuinely excited about data analytics as a path. Before
            any of that, I spent about 13 years on piano, which taught me
            perseverance and how to find the people and things that actually
            matter to me. I'm currently looking for data analyst and BI roles
            where I can do what I do best: ask the right questions, then build
            the visualization that makes the answer painfully obvious.
          </p>
        </div>
      </div>
    </section>
    <hr class="border-surface my-12" />
    <!-- Skills Section -->
    <section class="mb-12">
      <div class="bg-card/30 dark:bg-card/20 rounded-4xl p-6">
        <div
          class="text-text mb-6 text-lg font-semibold tracking-widest uppercase"
        >
          Skills
        </div>
        <div class="mb-4 grid grid-cols-1 gap-8 md:grid-cols-2">
          <div class="space-y-6">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <Skills
                  title="Languages"
                  items={["Python", "R", "SQL", "Java"]}
                  color="blue"
                />
              </div>
              <div>
                <Skills
                  title="Visualization & BI"
                  items={["R Shiny", "Plotly", "Tableau"]}
                  color="blue"
                />
              </div>
            </div>
          </div>

          <div class="space-y-6">
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
              <div>
                <Skills
                  title="Analysis"
                  items={["Statistical Modeling", "Monte Carlo", "GIS"]}
                  color="teal"
                />
              </div>
              <div>
                <Skills
                  title="Tools"
                  items={["Git", "Astro", "Flutter"]}
                  color="teal"
                />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    <hr class="border-surface my-12" />

    <!-- Education Section -->
    <section class="mb-12">
      <div
        class="border-surface bg-card/50 dark:bg-card/30 rounded-xl border p-5"
      >
        <div class="flex gap-4">
          <div
            class="border-surface bg-surface/50 text-text/70 flex h-10 w-10 shrink-0 items-center justify-center rounded-lg border text-xs font-semibold"
          >
            <Image
              src="/images/uc_shield.png"
              alt="Ursinus College logo"
              width={45}
              height={45}
              class="mt-4"
            />
          </div>
          <div class="flex-1">
            <h3 class="text-heading font-semibold">Ursinus College</h3>
            <p class="text-text mt-1 text-sm">
              B.S. Applied Mathematics · Computer Science Minor · May 2025
              <br /> GPA: 3.91/4.0
            </p>

            <div class="mt-4">
              <Skills
                title="Relevant Coursework"
                items={[
                  "Probability",
                  "Numerical Analysis",
                  "Software Engineering",
                  "Mathematical Statistics",
                ]}
                color="blue"
                size="small"
              />
            </div>

            <div class="mt-4">
              <Skills
                title="Activities & Honors"
                items={[
                  "Data Science Initiative (formerly IDSIRI)",
                  "DataFest Philly 2024/2025",
                  "MAA Prize of Service and Excellence in Mathematics",
                ]}
                color="teal"
                size="small"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <hr class="border-surface my-12" />

    <!-- Currently Seeking Section -->
    <section class="mb-12">
      <div
        class="flex flex-col gap-4 rounded-xl border border-teal-300 bg-teal-50 p-6 md:flex-row md:items-center md:justify-between dark:border-teal-600 dark:bg-teal-900/20"
      >
        <div>
          <h3 class="font-semibold text-teal-900 dark:text-teal-100">
            Open to full-time opportunities
          </h3>
          <p class="mt-1 text-sm text-teal-700 dark:text-teal-300">
            Data Analyst · Business Intelligence — Philadelphia area preferred,
            but open to remote.
          </p>
        </div>
        <button
          class="rounded-lg border border-teal-700 bg-transparent px-4 py-2 text-sm font-semibold whitespace-nowrap text-teal-700 transition-colors hover:bg-teal-100 dark:border-teal-300 dark:text-teal-300 dark:hover:bg-teal-900/40"
        >
          <a
            href="/Thompson_Eugene_Resume.pdf"
            target="_blank"
            rel="noopener noreferrer"
          >
            View resume
          </a>
        </button>
      </div>
    </section>
  </main>
</MainLayout>
